/upper/gyroa/scripts/*
!/upper/gyroa/scripts/build.mjs
/upper/gyroa/src/public/models/*
!/upper/gyroa/src/public/models/pcb.glb

# Local diagnostic sources and unused duplicate/host-only headers.
/src/diagnostics/
/src/bl_io.c
/inc/diagnostics/
/middleware/usb_drivers/inc/usbh_core.h
/middleware/usb_drivers/inc/usbh_ctrl.h
/middleware/usb_drivers/inc/usbh_int.h

