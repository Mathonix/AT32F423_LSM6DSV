{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ag-233688",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ag.233688.xyz", "custom_domain": true }],
  "build": { "command": "node scripts/build.mjs --domain=ag.233688.xyz" },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/healthz", "/api/releases", "/api/releases/*"]
  }
}
