!/Code/AT32F423_Firmware_Library/libraries/drivers/src/at32f423_usb.c

# Bootloader source only; local tools and compiled outputs stay private.
/Code/bootloader/*
!/Code/bootloader/Makefile
!/Code/bootloader/CMakeLists.txt
!/Code/bootloader/README.md
!/Code/bootloader/inc/
!/Code/bootloader/src/
!/Code/bootloader/linker/
/Code/bootloader/inc/usb_conf_project.h

# Keep only the latest buildable web host.
/upper/*
!/upper/gyroa/
/upper/gyroa/*
!/upper/gyroa/README.md
!/upper/gyroa/package.json
!/upper/gyroa/package-lock.json
!/upper/gyroa/wrangler.jsonc
!/upper/gyroa/wrangler.ag.jsonc
!/upper/gyroa/src/
!/upper/gyroa/scripts/
/upper/gyroa/scripts/*
!/upper/gyroa/scripts/build.mjs
!/upper/gyroa/scripts/build-previous-pages.mjs
!/upper/gyroa/pages/
/upper/gyroa/pages/*
!/upper/gyroa/pages/wrangler.jsonc
!/upper/gyroa/pages-previous/
/upper/gyroa/pages-previous/*
!/upper/gyroa/pages-previous/wrangler.jsonc
/upper/gyroa/src/public/models/*
!/upper/gyroa/src/public/models/pcb.glb

# README preview shot -- the only binary published from the web-host tree.
# The directory itself must be re-included first: git never descends into an
# excluded directory, so a file-level negation alone would have no effect.
!/upper/gyroa/docs/
!/upper/gyroa/docs/preview-status.jpg

# Local diagnostic sources and unused duplicate/host-only headers.
/Code/src/diagnostics/
/Code/src/bl_io.c
/Code/inc/diagnostics/
/Code/middleware/usb_drivers/inc/usbh_core.h
/Code/middleware/usb_drivers/inc/usbh_ctrl.h
/Code/middleware/usb_drivers/inc/usbh_int.h

# Native test suite stays local; only the published SPI DMA regression script
# ships. Without this pair the Code/ re-include would expose ~67 local files.
/Code/tests/*
!/Code/tests/test_spi_dma_capture.py

