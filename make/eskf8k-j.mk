# Frozen 20261017j build profile. Do not confuse six-axis VOFA output with
# SIX_AXIS=1: both independent filters and magnetometer fusion stay enabled.
TARGET ?= lsm6dsv_eskf8k_j
DEBUG_BUILD ?= 0
SIX_AXIS ?= 0
ESKF8K ?= 1
ESKF_VALIDATE ?= 1
ESKF_CAPTURE_OPT ?= 1
ESKF_CLOCK_OPT ?= 1
PROTOCOL_CRC_TABLE ?= 1
UART_RX_DMA ?= 1
FLASH_TRACE ?= 1
SRAM_CAPTURE ?= 1
USB_DIAG ?= 1
USB_TX_OWNERSHIP_FIX ?= 1
USB_TX_CHAIN ?= 1
USB_FIFO_FIX ?= 1
USB_BUFFER_FIX ?= 1
USB_PACK_FIX ?= 1
UART_TX_DIAG ?= 1
UART_TX_QUEUE_FIX ?= 1
CAN_TX_FAST ?= 1
UART_TX_SERVICE_2K ?= 1
VOFA_6AXIS ?= 1
ESKF_REST_RELAX ?= 1
ESKF_Q_COMP ?= 0
ESKF_Q_COMP_FAST ?= 0
STATIC6_DIAG ?= 0
ESKF_HOTSPOT ?= 0
COMM_POLL_FAST ?= 0
UART_TX_BATCH ?= 0
UART_TX_PAD_TEST ?= 0
