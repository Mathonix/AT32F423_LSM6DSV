{
  "name": "at32-motion-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "validate:source": "node scripts/validate-source.mjs",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "audit:firmware": "node scripts/audit-firmware.mjs",
    "validate": "npm run audit:firmware && npm run validate:source && npm run check && npm run lint && npm run test:rust"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5"
  }
}
