# Public repository: only firmware, paired BL, latest web host and licenses.
# Other working-tree material stays local. New top-level areas require opt-in.
/*
!/.gitignore
!/README.md
!/Makefile
!/LICENSES/
# CMake + Ninja build (parallel to the Makefile; same byte output).
!/CMakeLists.txt
!/CMakePresets.json
!/cmake/
# Firmware tree lives under Code/; re-including the directory is enough for git
# to descend, but every explicit exception below must carry the same prefix.
!/Code/
!/upper/

# Current user manual PDF: re-include the directory before its files (git never
# descends into an excluded directory), then re-hide everything except the pair
# the public README links to.
!/output/
/output/pdf/*
!/output/pdf/AT32_AHRS_使用说明书_20261024c.pdf
!/output/pdf/AT32_AHRS_使用说明书_20261024c.manifest.json

# Firmware dependencies selected from the compiler dependency files.
/Code/AT32F423_Firmware_Library/**
!/Code/AT32F423_Firmware_Library/libraries/
!/Code/AT32F423_Firmware_Library/libraries/cmsis/
!/Code/AT32F423_Firmware_Library/libraries/drivers/
!/Code/AT32F423_Firmware_Library/libraries/cmsis/cm4/
!/Code/AT32F423_Firmware_Library/libraries/drivers/inc/
!/Code/AT32F423_Firmware_Library/libraries/drivers/src/
!/Code/AT32F423_Firmware_Library/libraries/cmsis/cm4/core_support/
!/Code/AT32F423_Firmware_Library/libraries/cmsis/cm4/device_support/
!/Code/AT32F423_Firmware_Library/libraries/cmsis/cm4/device_support/startup/
!/Code/AT32F423_Firmware_Library/libraries/cmsis/cm4/device_support/startup/gcc/
!/Code/AT32F423_Firmware_Library/LICENSE
!/Code/AT32F423_Firmware_Library/libraries/cmsis/cm4/core_support/cmsis_compiler.h
!/Code/AT32F423_Firmware_Library/libraries/cmsis/cm4/core_support/cmsis_gcc.h
